# Copy to .env.local. None of these are needed for `npm run dev` — it starts a local MongoDB for you.

# MongoDB connection string. Must be a replica set (Atlas clusters are) so change streams work.
MONGODB_URI=

# Long random string used to sign login cookies. Generate one with: openssl rand -base64 32
JWT_SECRET=

# Optional. Enables Gemini-written insights on the dashboard; without it, built-in rules write them.
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-flash-latest

# Time zone used for "today", daily token numbering and the busiest-times heatmap.
APP_TIMEZONE=Asia/Kolkata
